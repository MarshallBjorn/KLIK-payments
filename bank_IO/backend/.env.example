# Adres API KLIK. Lokalnie bez dockera: http://localhost:8000/api/v1
# W docker-compose (serwis nazywa się "web"):    http://web:8000/api/v1
KLIK_BASE_URL=http://localhost:8000/api/v1

# Klucz API wystawiony bankowi przez operatora KLIK (Django Admin → Bank → api_key)
KLIK_BANK_API_KEY=

# Tożsamość mocka (kosmetyka UI + strefa wysyłana do /codes/generate)
BANK_NAME=BANK_MOCK
BANK_ZONE=PL

# TTL kodu (musi się zgadzać z KLIK_CODE_TTL_SECONDS w KLIK)
KLIK_CODE_TTL_SECONDS=120

# Timeout HTTP do KLIK (s)
KLIK_HTTP_TIMEOUT=10