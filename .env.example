# ╔══════════════════════════════════════════════════════════════════════╗
# ║  KLIK PAYMENTS — KONFIGURACJA ŚRODOWISKA                             ║
# ║                                                                      ║
# ║  Plik organizuje zmienne w sekcje wg topologii deploymentu.          ║
# ║                                                                      ║
# ║  WARIANTY DEPLOYMENTU:                                               ║
# ║                                                                      ║
# ║  [A] SINGLE-HOST (dev / demo) — wszystko na jednej maszynie          ║
# ║      `make dev-d` — uruchamia cały stack lokalnie.                   ║
# ║      Domyślne wartości w tym pliku pasują do single-host.            ║
# ║                                                                      ║
# ║  [B] SPLIT (prod / pre-prod) — dwa VPS                               ║
# ║      VPS-A: db, redis, web (KLIK), worker, beat, agent (terminal)    ║
# ║      VPS-B: rtgs-mock, bank-mock-backend, bank-mock-frontend         ║
# ║                                                                      ║
# ║      Na każdym VPS ten sam repo + ten sam .env, ale `docker compose  ║
# ║      up` z innym podzbiorem serwisów. Komunikacja przez publiczne    ║
# ║      URL-e — wpisy oznaczone "SPLIT-MODE" pokazują co zmienić.       ║
# ╚══════════════════════════════════════════════════════════════════════╝
# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 0: OBRAZY GHCR (tylko SPLIT / pull-based deploy)
#
#  docker-compose-vps-a.yml i -vps-b.yml ciągną gotowe obrazy z GHCR
#  zamiast budować na VPS-ie (oszczędność RAM). Te zmienne sterują skąd.
#  Single-host (make dev-d / make prod) ich nie używa — buduje lokalnie.
# ═══════════════════════════════════════════════════════════════════════
REGISTRY=ghcr.io
IMAGE_OWNER=marshallbjorn/klik-payments
# `latest` (push na main) albo konkretna wersja z tagu, np. 1.2.3
IMAGE_TAG=latest

# Porty hosta dla UI (mapowane na port 80 nginx w obrazach frontów).
# VPS-A:
AGENT_PORT=5175
# VPS-B:
BANK_MOCK_FRONTEND_PORT=5174

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 1: WSPÓLNE — Django core
# ═══════════════════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=change-me-to-something-secure-min-50-chars-long # pragma: allowlist secret
DEBUG=True

# Hosty pod którymi KLIK API jest dostępne (Host header).
# SPLIT-MODE: ALLOWED_HOSTS=klik.user.com,localhost,web
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Origins UI które wolno bić do KLIK API z przeglądarki.
# SPLIT-MODE: dodaj publiczny URL terminala, np.
#   CORS_ALLOWED_ORIGINS=https://terminal.user.com,http://localhost:5175
# Pomijasz — defaulty z dev.py wystarczą do single-host.
# CORS_ALLOWED_ORIGINS=

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 2: WSPÓLNE — PostgreSQL
#  (potrzebne tylko na VPS-A; mock-bank i rtgs-mock nie używają DB)
# ═══════════════════════════════════════════════════════════════════════
POSTGRES_DB=klik
POSTGRES_USER=klik
POSTGRES_PASSWORD=change-me # pragma: allowlist secret

# Te zmienne są używane PRZEZ Django do połączenia
DATABASE_URL=postgres://klik:change-me@db:5432/klik # pragma: allowlist secret

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 3: WSPÓLNE — Redis / Celery
#  (potrzebne tylko na VPS-A)
# ═══════════════════════════════════════════════════════════════════════
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 4: VPS-A — KLIK (logika domenowa)
# ═══════════════════════════════════════════════════════════════════════
# TTL kodu KLIK w sekundach (produkcja: 120s)
KLIK_CODE_TTL_SECONDS=120

# Interwał sesji rozliczeniowych per strefa (minuty).
# Prod: 1440 (24h). Demo/showcase: 2-15 min.
SESSION_INTERVAL_MINUTES_PL=1440
SESSION_INTERVAL_MINUTES_EU=1440
SESSION_INTERVAL_MINUTES_UK=1440
SESSION_INTERVAL_MINUTES_US=1440

# Timeout dispatcher → RTGS (sekundy)
RTGS_TIMEOUT_SECONDS=30

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 5: VPS-A → VPS-B — adresy bramek RTGS
#
#  KLIK (VPS-A) → RTGS mock (VPS-B). W single-host defaults pasują
#  (sieć compose, hostname rtgs-mock). W split podaj publiczny URL.
# ═══════════════════════════════════════════════════════════════════════
SORBNET3_URL=http://rtgs-mock:9000/sorbnet3
TARGET2_URL=http://rtgs-mock:9000/target2
CHAPS_URL=http://rtgs-mock:9000/chaps
FEDNOW_URL=http://rtgs-mock:9000/fednow

# mTLS — ODKOMENTUJ tylko jeśli recon pokaże, że /banks NIE działa po http.
# Ścieżki muszą być widoczne w kontenerach web+worker (zamontuj ich certs/).
# TARGET_CLIENT_CERT=/certs/banka.pem
# TARGET_CLIENT_KEY=/certs/banka.key
# TARGET_CA_CERT=/certs/ca.pem

# SPLIT-MODE przykład:
#   SORBNET3_URL=https://rtgs.kolega.com/sorbnet3
#   TARGET2_URL=https://rtgs.kolega.com/target2
#   CHAPS_URL=https://rtgs.kolega.com/chaps
#   FEDNOW_URL=https://rtgs.kolega.com/fednow
# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 6: VPS-A — Terminal (agent) UI
# ═══════════════════════════════════════════════════════════════════════
# Cel Vite proxy z UI agenta. W compose serwis Django = `web:8000`.
# SPLIT-MODE: agent jest na tym samym VPS co KLIK, więc default OK,
# chyba że agent biegnie poza Dockerem — wtedy http://localhost:8000.
AGENT_VITE_PROXY_TARGET=http://web:8000
# Hosty pod którymi agent UI jest dostępne (allowedHosts Vite).
# SPLIT-MODE: AGENT_ALLOWED_HOSTS=terminal.user.com,localhost
# `all` wyłącza weryfikację — używać tylko gdy reverse proxy autoryzuje wcześniej.
AGENT_ALLOWED_HOSTS=localhost,127.0.0.1
# SPLIT / pull-based: obraz agenta to nginx (statyk + proxy /api). Upstream
# KLIK-a w sieci compose VPS-A to web:8000 (default OK). AGENT_VITE_PROXY_TARGET
# i AGENT_ALLOWED_HOSTS wyżej dotyczą tylko dev (Vite), nie obrazu prod.
AGENT_KLIK_UPSTREAM=web:8000
# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 7: VPS-B — RTGS mock (failure injection)
# ═══════════════════════════════════════════════════════════════════════
# Latency per transfer (ms)
RTGS_LATENCY_MIN_MS=50
RTGS_LATENCY_MAX_MS=300

# Random failure rate (0.0-1.0). Demo: 0.1 żeby pokazać częściowy commit.
RTGS_FAIL_RATE=0.0

# Timeout rate (0.0-1.0)
RTGS_TIMEOUT_RATE=0.0

# Nazwy banków odrzucanych jako niewypłacalne (po przecinku).
# Demo: "Insolvent Bank,Bank Uposlon"
RTGS_BLACKLIST=

# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 8: VPS-B — Mock Banku (backend)
#
#  bank-mock-backend → KLIK. W single-host default to `web:8000`.
#  W split mock-bank biegnie u kolegi i musi mieć publiczny URL KLIK.
# ═══════════════════════════════════════════════════════════════════════

BANK_MOCK_NAME=BANK_MOCK
BANK_MOCK_ZONE=PL

# SPLIT-MODE: BANK_MOCK_KLIK_BASE_URL=https://klik.user.com/api/v1
BANK_MOCK_KLIK_BASE_URL=http://web:8000/api/v1

# Klucz API wygenerowany w Django Admin (Bank → api_key) dla tego banku.
# WYMAGANY do happy-path C2B i P2P. Bez niego KLIK odrzuca z 401.
BANK_MOCK_KLIK_BANK_API_KEY=


# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 9: VPS-B — Mock Banku (frontend)
# ═══════════════════════════════════════════════════════════════════════

# Hosty pod którymi mock-bank UI jest dostępne.
# SPLIT-MODE: BANK_MOCK_FRONTEND_ALLOWED_HOSTS=bank.kolega.com,localhost
BANK_MOCK_FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1


# ═══════════════════════════════════════════════════════════════════════
#  SEKCJA 10: PER-BANK (data, nie env) — przypomnienie
#
#  Webhook URL po stronie KLIK (Django Admin → Bank → webhook_url) musi
#  wskazywać na publicznie dostępny mock-bank:
#
#    SINGLE-HOST: http://bank-mock-backend:8100/webhook/authorize
#                 (w sieci compose; lub host.docker.internal:8100 z hosta)
#    SPLIT-MODE:  https://bank-api.kolega.com/webhook/authorize
#
#  To NIE jest .env — to pole w DB ustawiane przez admina KLIK per bank.
# ═══════════════════════════════════════════════════════════════════════
BANK_MOCK_KLIK_BANK_API_KEY=
