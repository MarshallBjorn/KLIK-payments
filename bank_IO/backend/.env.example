# Adres API KLIK. Tryby:
#   Lokalnie bez dockera:        http://localhost:8000/api/v1
#   docker-compose (single-host): http://web:8000/api/v1
#   SPLIT (mock-bank na innym VPS niż KLIK): https://klik.user.com/api/v1
#
# UWAGA: w docker-compose ten plik NIE jest czytany — wartość pochodzi z .env
# w roocie repo (zmienna BANK_MOCK_KLIK_BASE_URL przekazywana przez compose).
# Ten plik jest dla uruchomień standalone (uvicorn poza Dockerem).
KLIK_BASE_URL=http://localhost:8000/api/v1

# Klucz API wystawiony bankowi przez operatora KLIK (Django Admin → Bank → api_key)
KLIK_BANK_API_KEY=

# Tożsamość mocka (kosmetyka UI + strefa wysyłana do /codes/generate)
BANK_NAME=BANK_MOCK
BANK_ZONE=PL

# TTL kodu (musi się zgadzać z KLIK_CODE_TTL_SECONDS w KLIK)
KLIK_CODE_TTL_SECONDS=120

# Timeout HTTP do KLIK (s)
KLIK_HTTP_TIMEOUT=10
